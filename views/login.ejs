<%- include('header', { title: 'Trainer login' }) %>
<section class="auth">
  <h1>Trainer login</h1>
  <p class="muted">Single classroom login — projected on screen for trainees to learn from. No student accounts.</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form method="POST" action="/login" class="card form">
    <label>Trainer email<input name="email" type="email" required placeholder="admin@salon.academy"></label>
    <label>Password<input name="password" type="password" required placeholder="••••••••"></label>
    <button class="btn big" type="submit">Login →</button>
    <p class="muted small">Default: <code>admin@salon.academy</code> / <code>admin123</code> (override via ADMIN_EMAIL / ADMIN_PASSWORD).</p>
  </form>
</section>
<%- include('footer') %>
