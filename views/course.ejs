<%- include('header', { title: course.title }) %>
<a href="/dashboard">← Course library</a>
<div class="demo-banner">📽️ <b>Trainer mode</b> — all <%= course.modules.length %> modules are open. Teach in any order.</div>
<div class="course-head" style="--c:<%= course.color %>">
  <div><span class="cc-icon big"><%= course.icon %></span></div>
  <div><h1><%= course.title %></h1><p><%= course.tagline %></p><p class="muted"><%= course.duration %> · <%= course.level %></p>
  <p class="small">🌍 Standards: <%= standards.join(' · ') %></p></div>
</div>
<p><%= course.description %></p>
<h3>What trainees will be able to do</h3>
<ul class="ticks"><% course.outcomes.forEach(o=>{ %><li>✓ <%= o %></li><% }) %></ul>
<h2>🗓️ All modules — pick any</h2>
<div class="timeline">
<% course.modules.forEach((m, i) => { %>
  <div class="tl-row">
    <div class="tl-week"><%= m.weekLabel %><br><small><%= m.hours %></small></div>
    <div class="tl-body">
      <h3>○ <%= i+1 %>. <%= m.title %></h3>
      <p class="muted"><%= m.objectives.slice(0,2).join(' · ') %></p>
      <div class="row">
        <a class="btn small" href="/course/<%= course.id %>/module/<%= i %>">Teach this →</a>
        <span class="chip"><%= m.activity.type %> · classroom</span>
      </div>
    </div>
  </div>
<% }) %>
</div>
<%- include('footer') %>
