<%- include('header', { title: mod.title }) %>
<a href="/course/<%= course.id %>">← <%= course.title %></a>
<div class="demo-banner">📽️ <b>Trainer mode</b> — projected for the class. All modules open, no locks. Follow the 55-min flow below.</div>
<div class="mod-head" style="--c:<%= course.color %>">
  <div><span class="pill"><%= mod.weekLabel %> · <%= mod.hours %> · Module <%= idx+1 %> of <%= total %></span>
  <h1><%= idx+1 %>. <%= mod.title %></h1>
  <p class="muted">🌍 <%= standards.join(' · ') %></p></div>
  <div class="mod-nav">
    <% if (idx > 0) { %><a class="btn small ghost" href="/course/<%= course.id %>/module/<%= idx-1 %>">← Prev</a><% } %>
    <% if (idx < total-1) { %><a class="btn small ghost" href="/course/<%= course.id %>/module/<%= idx+1 %>">Next →</a><% } %>
  </div>
</div>

<div class="card">
  <h2>⏱️ 55-minute classroom flow</h2>
  <div class="tablewrap"><table>
    <tr><th>Phase</th><th>Time</th><th>What trainer does</th></tr>
    <% flow.forEach(f => { %><tr><td><b><%= f.phase %></b></td><td><%= f.mins %></td><td><%= f.what %></td></tr><% }) %>
  </table></div>
  <p class="muted small">Safety to read aloud: <%= rules[0] %> Plus RAG triage — RED refuse+refer, AMBER adapt, GREEN proceed.</p>
</div>

<div class="tabs">
  <button class="tab active" data-t="learn">📖 Learn</button>
  <button class="tab" data-t="lab">🧊 3D Lab</button>
  <button class="tab" data-t="act">👩‍🏫 Classroom activity</button>
  <button class="tab" data-t="quiz">📝 Knowledge check</button>
  <button class="tab" data-t="prac">💈 Salon application</button>
</div>

<section class="tabpage active" id="t-learn">
  <div class="card"><h2>🎯 Objectives (<%= mod.hours %>)</h2><ul class="ticks"><% mod.objectives.forEach(o=>{ %><li>✓ <%= o %></li><% }) %></ul></div>
  <div class="card prose"><h2>📖 Theory — teach on screen</h2><%- mod.theory %></div>
  <% if (mod.deepTheory) { %><div class="card prose deep"><h2>🔬 Deep dive — international professional standard</h2><%- mod.deepTheory %><%- mod.deepExtra || '' %><p class="muted small">Benchmark: CIDESCO / CIBTAC / VTCT-HABIA depth — barrier science, bond chemistry, RAG safety, Fitzpatrick gating, EU/WHO hygiene.</p></div><% } %>
  <% if (mod.caseStudy) { %><div class="card case"><h2>🧾 Classroom case: <%= mod.caseStudy.title %></h2><p><%= mod.caseStudy.brief %></p><ol><% mod.caseStudy.tasks.forEach(t=>{ %><li><%= t %></li><% }) %></ol><p class="debrief"><b>Trainer debrief (reveal after discussion):</b> <%= mod.caseStudy.debrief %></p></div><% } %>
  <div class="card"><h2>👁️ Live demo steps — trainer performs</h2><div class="vsteps"><% mod.visualSteps.forEach(s=>{ %><div class="vstep"><span><%= s.e %></span><p><%= s.t %></p></div><% }) %></div><p class="muted small">Narrate every decision while demonstrating. Ask “what did you see?” after each step.</p></div>
</section>

<section class="tabpage" id="t-lab">
  <div class="card"><h2>🧊 <%= mod.threeD.title %></h2><p class="muted"><%= mod.threeD.description %></p>
    <div id="threeWrap" data-theme="<%= mod.threeD.type %>" data-course="<%= course.id %>" data-idx="<%= idx %>" class="three-wrap"><p class="muted">🖱️ Drag to rotate · pinch/scroll to zoom · project full-screen</p><div id="threeBox"></div></div>
    <div class="scene-panel">
      <div class="row"><span class="pill" id="sceneKicker">🔧 Tool demo</span><span id="stepDots" class="step-dots"></span></div>
      <h3 id="stepTitle"></h3>
      <p id="stepDesc" class="muted"></p>
      <div class="row"><button class="btn small ghost" id="stepPrev">← Prev</button><button class="btn small" id="stepNext">Next →</button><button class="btn small ghost" id="spinBtn">⏸ Pause spin</button></div>
    </div>
  </div>
</section>

<section class="tabpage" id="t-act">
  <div class="card">
    <div class="pill">👩‍🏫 <%= classroom.mode %> · <%= classroom.timing %></div>
    <h2>🎮 <%= classroom.title %></h2>
    <p class="muted"><%= classroom.trainerScript %></p>
    <p><b>Class task:</b> <%= classroom.taskForClass %></p>
    <p class="muted small">Materials: <%= classroom.materials %></p>
    <% if (mod.activity.type === 'checklist') { %>
      <div id="actBox"><% mod.activity.items.forEach((it,i)=>{ %><label class="check"><input type="checkbox" data-i="<%= i %>"> <%= it %> — <span class="muted">demo live, tick together</span></label><% }) %></div>
      <p><b id="actScore">0/<%= mod.activity.items.length %></b> <span class="muted">— trainer ticks on projector as class completes</span></p>
    <% } else if (mod.activity.type === 'cards') { %>
      <div class="flipgrid" id="actBox"><% mod.activity.items.forEach(p=>{ %><div class="flip" data-a="<%= p[0] %>" data-b="<%= p[1] %>"><div class="fin">❓<br><b><%= p[0] %></b><br><small>ask class, tap to reveal</small></div></div><% }) %></div>
      <p class="muted">Cold-call, 30 sec per card. Loser pair demonstrates next.</p>
    <% } else if (mod.activity.type === 'mixer') { %>
      <div id="actBox"><p><b>Trainer reveals one by one — class must defend the match in one sentence</b></p>
      <% mod.activity.items.forEach(p=>{ %><div class="mixrow"><span><%= p[0] %></span><button class="btn small ghost mixbtn" data-ok="<%= p[1] %>">reveal →</button></div><% }) %></div>
    <% } else { %>
      <div id="actBox"><p><b>Pairs get 2 min per scenario, then defend with the rule cited</b></p><% mod.activity.items.forEach(p=>{ %><details class="scen"><summary><b><%= p[0] %></b> — discuss, then tap to reveal standard</summary><p>✅ <%= p[1] %></p></details><% }) %></div>
    <% } %>
  </div>
</section>

<section class="tabpage" id="t-quiz">
  <div class="card">
    <h2>📝 Oral knowledge check (pass ≥ <%= Math.round((mod.passMark || 0.6) * 100) %>%) — hands up, no devices</h2>
    <p class="muted">Trainer reads each question, class votes, then reveals explanation. No tracking — mastery is vocal.</p>
    <div id="quizBox" data-course="<%= course.id %>" data-idx="<%= idx %>">
      <% questions.forEach((q, qi)=>{ %>
        <div class="q" data-answer="<%= q.answer %>">
          <p><b>Q<%= qi+1 %>. <%= q.q %></b></p>
          <% q.options.forEach((op, oi)=>{ %><label class="opt"><input type="radio" name="q<%= qi %>" value="<%= oi %>"> <%= op %></label><% }) %>
          <p class="explain hidden">💡 <%= q.explain %></p>
        </div>
      <% }) %>
      <button class="btn big" id="quizBtn">Reveal all answers →</button>
      <p id="quizRes" class="muted">Trainees answer aloud first — then reveal.</p>
    </div>
  </div>
</section>

<section class="tabpage" id="t-prac">
  <div class="card practical">
    <h2>💈 Salon application: <%= mod.practical.title %></h2>
    <p><b>Trainer demo task:</b> <%= mod.practical.task %></p>
    <p><b>Outcome for trainees:</b> <%= mod.practical.outcome %></p>
    <h3>Trainee homework checklist</h3>
    <ul class="ticks"><% mod.practical.checklist.forEach(c=>{ %><li>☐ <%= c %></li><% }) %></ul>
    <% if (mod.rubric) { %>
    <h3>📊 Grading rubric — <%= mod.rubric.title %> (pass: mostly 3–4)</h3>
    <div class="tablewrap"><table>
      <tr><th>Criterion</th><th>1 — Not yet</th><th>2 — Developing</th><th>3 — Competent</th><th>4 — Professional</th></tr>
      <% mod.rubric.criteria.forEach(r=>{ %><tr><td><b><%= r.name %></b></td><% r.levels.forEach(l=>{ %><td><%= l %></td><% }) %></tr><% }) %>
    </table></div>
    <p class="muted"><b>Evidence required:</b> <%= mod.rubric.evidence %></p>
    <% } %>
    <p class="muted">Trainer assigns this as supervised in-salon practice. Review next class with photos / observation sheets.</p>
  </div>
</section>

<%- include('footer') %>
