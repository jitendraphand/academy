<%- include('header', { title: 'Course library' }) %>
<h1>📚 Course library — all open</h1>
<p class="muted">Trainer picks any course and any module. No locks, no progress tracking — pure classroom teaching.</p>
<div class="grid3">
<% courses.forEach((course) => { %>
  <article class="course-card" style="--c:<%= course.color %>">
    <div class="cc-top"><span class="cc-icon"><%= course.icon %></span><span class="cc-dur"><%= course.modules.length %> modules</span></div>
    <h2><%= course.title %></h2>
    <p class="muted"><%= course.tagline %></p>
    <p class="small"><%= course.duration %> · <%= course.level %></p>
    <p class="small muted">Standards: <%= (courseStandards[course.id] || []).join(' · ') %></p>
    <a class="btn" href="/course/<%= course.id %>">Open modules →</a>
  </article>
<% }) %>
</div>
<%- include('footer') %>
