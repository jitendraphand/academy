<%- include('header', { title: 'My Learning' }) %>
<h1>📚 My Learning</h1>
<% if (!cards.length) { %>
  <div class="card"><h3>No courses yet</h3><p>Ask your admin to grant you access (Admin → Grant access).</p></div>
<% } %>
<div class="grid3">
<% cards.forEach(({course, progress}) => { %>
  <article class="course-card" style="--c:<%= course.color %>">
    <div class="cc-top"><span class="cc-icon"><%= course.icon %></span><span class="cc-dur"><%= progress.completed %>/<%= progress.total %> done</span></div>
    <h2><%= course.title %></h2>
    <p class="muted"><%= course.tagline %></p>
    <div class="pbar"><div style="width:<%= progress.pct %>%"></div></div>
    <p><b><%= progress.pct %>%</b> complete</p>
    <a class="btn" href="/course/<%= course.id %>"><%= progress.pct ? 'Continue →' : 'Start →' %></a>
  </article>
<% }) %>
</div>
<%- include('footer') %>
